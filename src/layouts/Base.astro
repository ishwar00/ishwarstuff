---
import iosevka400 from '@fontsource/iosevka/files/iosevka-latin-400-normal.woff2?url'
import iosevka400i from '@fontsource/iosevka/files/iosevka-latin-400-italic.woff2?url'
import iosevka600 from '@fontsource/iosevka/files/iosevka-latin-600-normal.woff2?url'
import type { categories } from '../content.config'

interface Props {
  title: string
  category?: (typeof categories)[number]
}
const { title, category } = Astro.props

// font-display: fallback waits up to 100ms for Iosevka before showing the fallback font,
// so cached or preloaded fonts never swap in visibly.
const face = (src: string, weight: number, style: string) =>
  `@font-face{font-family:'Iosevka';font-style:${style};font-weight:${weight};font-display:fallback;src:url(${src}) format('woff2')}`
const fontFaces = [face(iosevka400, 400, 'normal'), face(iosevka400i, 400, 'italic'), face(iosevka600, 600, 'normal')].join('')
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Preload the main weights so the first paint already uses Iosevka (no font swap on navigation). -->
    <link rel="preload" href={iosevka400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={iosevka600} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>
    <script is:inline>
      // Set the theme before first paint: saved choice, else the system setting.
      try {
        var t = localStorage.getItem('theme')
      } catch (e) {}
      document.documentElement.dataset.theme =
        t || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
    </script>
  </head>
  <body data-category={category}>
    <main>
      <button class="theme" type="button" aria-label="Dark mode">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor"></path>
        </svg>
      </button>
      <slot />
    </main>
    <script>
      const button = document.querySelector<HTMLButtonElement>('.theme')!
      const sync = () => {
        const dark = document.documentElement.dataset.theme === 'dark'
        button.setAttribute('aria-pressed', String(dark))
        button.title = dark ? 'Switch to light mode' : 'Switch to dark mode'
      }
      sync()
      const root = document.documentElement
      const apply = () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark'
        root.dataset.theme = next
        try {
          localStorage.setItem('theme', next)
        } catch {}
        sync()
      }
      button.addEventListener('click', () => {
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
        if (!document.startViewTransition || reduce) return apply()

        // The new theme grows out of the toggle as a circle until it covers the page.
        const { left, top, width, height } = button.getBoundingClientRect()
        const x = left + width / 2
        const y = top + height / 2
        const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y))
        root.classList.add('theme-switching')
        const transition = document.startViewTransition(apply)
        transition.ready
          .then(() =>
            root.animate(
              { clipPath: [`circle(0 at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`] },
              {
                duration: 450,
                easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)',
                pseudoElement: '::view-transition-new(root)'
              }
            )
          )
          // The browser skips the transition in some cases (e.g. a hidden tab); the theme still switches.
          .catch(() => {})
        transition.finished.finally(() => root.classList.remove('theme-switching'))
      })
    </script>
  </body>
</html>

<style is:global>
  /* Cross-fade between pages instead of blanking and repainting on every click. */
  @view-transition {
    navigation: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    @view-transition {
      navigation: none;
    }
  }
  /* Page switches: the clicked title and the site name glide into place; everything else cross-fades. */
  ::view-transition-group(*) {
    animation-duration: 0.4s;
    animation-timing-function: cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  /* Theme switch: replace the default cross-fade with the circle reveal set up in the script. */
  .theme-switching::view-transition-old(root),
  .theme-switching::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }

  :root {
    --paper: #f5f6f2;
    --ink: #1f252b;
    --muted: #68717b;
    --rule: #dfe2dc;
    --code-bg: #eceee8;
    --eng: #2c46c4;
    --life: #8c3a62;

    --font: 'Iosevka', ui-monospace, monospace;

    /* Home and engineering pages use the cobalt accent; life pages override below. */
    --accent: var(--eng);
    --body-leading: 1.65;
    color-scheme: light;
  }
  :root[data-theme='dark'] {
    color-scheme: dark;
    --paper: #14171a;
    --ink: #dfe3e6;
    --muted: #8d969f;
    --rule: #2a2f34;
    --code-bg: #1b1f23;
    --eng: #93a5ff;
    --life: #d895b8;
  }
  [data-theme='dark'] .astro-code span {
    color: var(--shiki-dark) !important;
  }
  [data-category='life'] {
    --accent: var(--life);
    --body-leading: 1.75;
  }

  html {
    font-size: 93.75%; /* 15px at the browser default, still scales with user settings */
  }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font);
    font-size: 1rem;
    line-height: var(--body-leading);
    -webkit-font-smoothing: antialiased;
  }
  main {
    position: relative;
    max-width: 38rem;
    margin: 0 auto;
    padding: 5rem 1.25rem 6rem;
  }
  .theme {
    position: absolute;
    top: 1.5rem;
    right: 1.25rem;
    padding: 0.4rem;
    border: 0;
    background: none;
    color: var(--muted);
    cursor: pointer;
    line-height: 0;
  }
  .theme:hover {
    color: var(--ink);
  }
  /* The circle turns a half turn with each theme switch. */
  .theme svg {
    transition: transform 0.4s ease;
  }
  [data-theme='dark'] .theme svg {
    transform: rotate(180deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .theme svg {
      transition: none;
    }
  }

  h1,
  h2,
  h3 {
    line-height: 1.2;
    font-weight: 600;
  }
  h2 {
    font-size: 1.375rem;
    margin: 2.75rem 0 0.75rem;
  }
  h3 {
    font-size: 1.125rem;
    margin: 2rem 0 0.5rem;
  }

  ::selection {
    background: color-mix(in srgb, var(--accent) 25%, transparent);
  }

  a {
    color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  a:hover {
    text-decoration-thickness: 2px;
  }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* Footnotes: a tappable marker, and a little room above whatever a jump lands on. */
  sup a {
    padding: 0.15em 0.3em;
  }
  :target {
    scroll-margin-top: 2rem;
  }
  .footnotes li:target {
    background: var(--code-bg);
    border-radius: 4px;
  }

  .signoff {
    margin-top: 3rem;
    text-align: center;
    font-style: italic;
    color: var(--muted);
  }

  del {
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }

  code {
    font-family: inherit;
    font-size: 0.95em;
  }
  :not(pre) > code {
    background: var(--code-bg);
    padding: 0.1em 0.35em;
    border-radius: 3px;
  }

  /* Shiki code blocks: own background, language name, line numbers. */
  .astro-code {
    position: relative;
    background-color: transparent !important;
    margin: 1.75rem 0;
    padding: 1.6rem 0 0.5rem;
    font-size: 0.875rem;
    line-height: 1.6;
    scrollbar-width: thin;
    scrollbar-color: var(--rule) transparent;
  }
  .astro-code::before {
    content: attr(data-language);
    position: absolute;
    top: 0;
    left: 0;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .astro-code code {
    counter-reset: line;
  }
  .astro-code .line::before {
    counter-increment: line;
    content: counter(line);
    display: inline-block;
    width: 2ch;
    margin-right: 1.5ch;
    text-align: right;
    color: var(--muted);
    opacity: 0.6;
  }
</style>
