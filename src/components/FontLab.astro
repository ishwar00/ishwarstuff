---
// Dev-only font picker for trying typefaces live. Delete once fonts are chosen.
import '@fontsource/iosevka/400.css'
import '@fontsource/iosevka/600.css'
import '@fontsource/iosevka-aile/400.css'
import '@fontsource/iosevka-aile/400-italic.css'
import '@fontsource/iosevka-aile/600.css'
import '@fontsource/iosevka-etoile/400.css'
import '@fontsource/iosevka-etoile/400-italic.css'
import '@fontsource/iosevka-etoile/600.css'
import '@fontsource-variable/instrument-sans'
import '@fontsource-variable/ibm-plex-sans'
import '@fontsource-variable/atkinson-hyperlegible-next'
import '@fontsource-variable/source-serif-4'
import '@fontsource-variable/newsreader'

const options = {
  sans: [
    ['Schibsted Grotesk', "'Schibsted Grotesk Variable', sans-serif"],
    ['Iosevka Aile', "'Iosevka Aile', sans-serif"],
    ['Iosevka', "'Iosevka', monospace"],
    ['Instrument Sans', "'Instrument Sans Variable', sans-serif"],
    ['IBM Plex Sans', "'IBM Plex Sans Variable', sans-serif"],
    ['Atkinson Hyperlegible', "'Atkinson Hyperlegible Next Variable', sans-serif"]
  ],
  serif: [
    ['Literata', "'Literata Variable', serif"],
    ['Iosevka Etoile', "'Iosevka Etoile', serif"],
    ['Source Serif 4', "'Source Serif 4 Variable', serif"],
    ['Newsreader', "'Newsreader Variable', serif"]
  ],
  mono: [
    ['JetBrains Mono', "'JetBrains Mono Variable', monospace"],
    ['Iosevka', "'Iosevka', monospace"]
  ],
  size: [
    ['15px', '93.75%'],
    ['16px', '100%'],
    ['17px', '106.25%'],
    ['18px', '112.5%']
  ]
}
const labels = { sans: 'Engineering', serif: 'Life', mono: 'Code', size: 'Size' }
---

<form class="fontlab" aria-label="Font picker (dev only)">
  {Object.entries(options).map(([key, opts]) => (
    <label>
      {labels[key as keyof typeof labels]}
      <select name={key}>
        {opts.map(([name, value]) => (
          <option value={value} selected={key === 'size' && name === '16px'}>{name}</option>
        ))}
      </select>
    </label>
  ))}
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('.fontlab')!
  const root = document.documentElement
  const apply = (key: string, value: string) => {
    if (key === 'size') root.style.fontSize = value
    else root.style.setProperty(`--${key}`, value)
  }
  const saved = JSON.parse(localStorage.getItem('fontlab') ?? '{}')
  for (const [key, value] of Object.entries(saved) as [string, string][]) {
    const select = form.elements.namedItem(key) as HTMLSelectElement | null
    if (select) select.value = value
    apply(key, value)
  }
  form.addEventListener('change', (e) => {
    const select = e.target as HTMLSelectElement
    apply(select.name, select.value)
    saved[select.name] = select.value
    localStorage.setItem('fontlab', JSON.stringify(saved))
  })
</script>

<style>
  .fontlab {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    display: grid;
    gap: 0.4rem;
    padding: 0.75rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 6px;
    font: 12px/1.3 system-ui, sans-serif;
    color: var(--muted);
    z-index: 10;
  }
  label {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    align-items: center;
  }
  select {
    font: inherit;
  }
</style>
