---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import type { categories } from '../content.config'

interface Props {
  category?: (typeof categories)[number]
}
const { category } = Astro.props

const posts = (await getCollection('posts'))
  .filter((p) => !category || p.data.category === category)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const tabs = [
  { label: 'All', href: '/', active: !category },
  { label: 'Engineering', href: '/engineering', active: category === 'engineering' },
  { label: 'Life', href: '/life', active: category === 'life' }
]

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })
---

<Base title="Ishwar">
  <h1>Ishwar</h1>
  <p>
    I build software, mostly backend. I've poked at compilers, VMs, and a JavaScript
    runtime. This is where I write things down: some engineering, some life.
  </p>
  <p class="links">
    <a href="https://github.com/ishwar00">github</a> ·
    <a href="https://flowcv.com/resume/7na4abrtft">resume</a> ·
    <a href="https://x.com/Ishwar71078132">x</a>
  </p>

  <nav>
    {tabs.map((t) => (
      <a href={t.href} aria-current={t.active ? 'page' : undefined}>{t.label}</a>
    ))}
  </nav>

  {posts.length === 0 ? (
    <p class="empty">Nothing here yet.</p>
  ) : (
    <ul>
      {posts.map((p) => (
        <li>
          {!category && <span class="tag">{p.data.category === 'engineering' ? 'eng' : 'life'}</span>}
          <a href={`/${p.data.category}/${p.id}`}>{p.data.title}</a>
          <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
        </li>
      ))}
    </ul>
  )}
</Base>

<style>
  h1 {
    margin-top: 0;
  }
  .links {
    color: var(--muted);
  }
  nav {
    display: flex;
    gap: 1.5rem;
    margin-top: 3rem;
    border-bottom: 1px solid var(--rule);
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  nav a[aria-current='page'] {
    color: var(--text);
    border-bottom-color: var(--accent);
  }
  ul {
    list-style: none;
    padding: 0;
  }
  li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.6rem 0;
  }
  li a {
    color: var(--text);
    text-decoration: none;
    flex: 1;
  }
  li a:hover {
    color: var(--accent);
  }
  .tag {
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    color: var(--muted);
    width: 2.5rem;
  }
  time,
  .empty {
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
