---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import type { categories } from '../content.config'

interface Props {
  category?: (typeof categories)[number]
}
const { category } = Astro.props

// Every tab page renders all posts; the tab only decides which are hidden.
// The script below switches tabs in place, so a tab click never reloads the page.
const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
)
const shown = (c: string) => !category || c === category

const tabs = [
  { label: 'All', href: '/', key: undefined },
  { label: 'Engineering', href: '/engineering', key: 'engineering' },
  { label: 'Life', href: '/life', key: 'life' }
] as const

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })
---

<Base title="Ishwar">
  <h1>Ishwar</h1>
  <p class="intro">
    I build software, mostly backend. I've poked at compilers, VMs, and a JavaScript
    runtime. This is where I write things down: some engineering, some life.
  </p>
  <p class="elsewhere">
    Code on <a href="https://github.com/ishwar00">GitHub</a>,{' '}
    work history in my <a href="https://flowcv.com/resume/7na4abrtft">resume</a>,{' '}
    short thoughts on <a href="https://x.com/Ishwar71078132">X</a>.
  </p>

  <nav aria-label="Filter posts">
    {tabs.map((t) => (
      <a
        href={t.href}
        data-category={t.key}
        aria-current={t.key === category ? 'page' : undefined}
      >
        {t.label}
      </a>
    ))}
    <span class="indicator" aria-hidden="true"></span>
  </nav>

  <ul>
    {posts.map((p) => (
      <li data-category={p.data.category} hidden={!shown(p.data.category)}>
        <a href={`/${p.data.category}/${p.id}`}>{p.data.title}</a>
        <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
      </li>
    ))}
  </ul>
  <p class="empty" hidden={posts.some((p) => shown(p.data.category))}>No posts here yet.</p>
</Base>

<script>
  const tabs = [...document.querySelectorAll<HTMLAnchorElement>('nav a')]
  const items = [...document.querySelectorAll<HTMLLIElement>('li[data-category]')]
  const empty = document.querySelector<HTMLElement>('.empty')!
  const nav = document.querySelector<HTMLElement>('nav')!
  const indicator = nav.querySelector<HTMLElement>('.indicator')!

  // Slide the underline under the current tab, taking on that tab's accent color.
  const moveIndicator = (animate: boolean) => {
    const tab = tabs.find((t) => t.hasAttribute('aria-current')) ?? tabs[0]
    if (!animate) indicator.style.transition = 'none'
    indicator.style.width = `${tab.offsetWidth}px`
    indicator.style.transform = `translateX(${tab.offsetLeft}px)`
    indicator.style.backgroundColor = getComputedStyle(tab).getPropertyValue('--accent')
    if (!animate) {
      indicator.offsetWidth // apply the jump before turning transitions back on
      indicator.style.transition = ''
    }
    nav.classList.add('sliding')
  }

  const show = (path: string) => {
    const tab = tabs.find((t) => t.pathname === path) ?? tabs[0]
    const key = tab.dataset.category
    for (const t of tabs) {
      if (t === tab) t.setAttribute('aria-current', 'page')
      else t.removeAttribute('aria-current')
    }
    for (const li of items) li.hidden = !!key && li.dataset.category !== key
    empty.hidden = items.some((li) => !li.hidden)
    moveIndicator(true)
  }

  moveIndicator(false)
  document.fonts.ready.then(() => moveIndicator(false))
  addEventListener('resize', () => moveIndicator(false))

  for (const tab of tabs) {
    tab.addEventListener('click', (e) => {
      // Let modified clicks (new tab, new window) behave like normal links.
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return
      e.preventDefault()
      if (tab.pathname !== location.pathname) history.pushState(null, '', tab.href)
      show(tab.pathname)
    })
  }
  addEventListener('popstate', () => show(location.pathname))
</script>

<style>
  h1 {
    font-size: 2.5rem;
    margin: 0 0 1.5rem;
  }
  .intro {
    font-size: 1.125rem;
    line-height: 1.6;
    margin: 0 0 1rem;
  }
  .elsewhere {
    color: var(--muted);
    font-size: 0.9375rem;
    margin: 0;
  }
  .elsewhere a {
    color: inherit;
    /* Bigger hit area for touch without shifting the text. */
    padding: 0.35rem 0.5rem;
    margin-inline: -0.5rem;
  }

  nav {
    position: relative;
    display: flex;
    gap: 1.75rem;
    margin-top: 4rem;
    border-bottom: 1px solid var(--rule);
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  /* Life is set in italic everywhere on this page, so the tabs double as the legend. */
  nav a[data-category='life'] {
    font-style: italic;
  }
  nav a:hover {
    color: var(--ink);
  }
  nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
  /* With JavaScript, a single sliding bar replaces the per-tab underline. */
  .indicator {
    position: absolute;
    bottom: -1px;
    left: 0;
    height: 2px;
    opacity: 0;
    transition:
      transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1),
      width 0.3s cubic-bezier(0.2, 0.7, 0.2, 1),
      background-color 0.3s ease;
  }
  nav.sliding .indicator {
    opacity: 1;
  }
  nav.sliding a[aria-current='page'] {
    border-bottom-color: transparent;
  }
  @media (prefers-reduced-motion: reduce) {
    .indicator {
      transition: none;
    }
  }

  li[hidden],
  .empty[hidden] {
    display: none;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
  }
  li {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.7rem 0;
  }
  li a {
    flex: 1;
    color: var(--ink);
    text-decoration: none;
    font-size: 1.0625rem;
    font-weight: 600;
  }
  li[data-category='life'] a {
    font-style: italic;
    font-weight: 400;
  }
  li a:hover {
    color: var(--accent);
  }
  time,
  .empty {
    color: var(--muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 30rem) {
    li {
      flex-direction: column;
      gap: 0.1rem;
    }
  }
</style>
