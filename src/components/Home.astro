---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import type { categories } from '../content.config'

interface Props {
  category?: (typeof categories)[number]
}
const { category } = Astro.props

const posts = (await getCollection('posts'))
  .filter((p) => !category || p.data.category === category)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const tabs = [
  { label: 'All', href: '/', key: undefined },
  { label: 'Engineering', href: '/engineering', key: 'engineering' },
  { label: 'Life', href: '/life', key: 'life' }
] as const

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })
---

<Base title="Ishwar">
  <h1>Ishwar</h1>
  <p class="intro">
    I build software, mostly backend. I've poked at compilers, VMs, and a JavaScript
    runtime. This is where I write things down: some engineering, some life.
  </p>
  <p class="elsewhere">
    Code on <a href="https://github.com/ishwar00">GitHub</a>,{' '}
    work history in my <a href="https://flowcv.com/resume/7na4abrtft">resume</a>,{' '}
    short thoughts on <a href="https://x.com/Ishwar71078132">X</a>.
  </p>

  <nav aria-label="Filter posts">
    {tabs.map((t) => (
      <a
        href={t.href}
        data-category={t.key}
        aria-current={t.key === category ? 'page' : undefined}
      >
        {t.label}
      </a>
    ))}
  </nav>

  {posts.length === 0 ? (
    <p class="empty">No posts here yet.</p>
  ) : (
    <ul>
      {posts.map((p) => (
        <li data-category={p.data.category}>
          <a href={`/${p.data.category}/${p.id}`}>{p.data.title}</a>
          <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
        </li>
      ))}
    </ul>
  )}
</Base>

<style>
  h1 {
    font-size: 2.5rem;
    margin: 0 0 1.5rem;
  }
  .intro {
    font-size: 1.125rem;
    line-height: 1.6;
    margin: 0 0 1rem;
  }
  .elsewhere {
    color: var(--muted);
    font-size: 0.9375rem;
    margin: 0;
  }
  .elsewhere a {
    color: inherit;
  }

  nav {
    display: flex;
    gap: 1.75rem;
    margin-top: 4rem;
    border-bottom: 1px solid var(--rule);
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  /* Life is set in italic everywhere on this page, so the tabs double as the legend. */
  nav a[data-category='life'] {
    font-style: italic;
  }
  nav a:hover {
    color: var(--ink);
  }
  nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
  }
  li {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.7rem 0;
  }
  li a {
    flex: 1;
    color: var(--ink);
    text-decoration: none;
    font-size: 1.0625rem;
    font-weight: 600;
  }
  li[data-category='life'] a {
    font-style: italic;
    font-weight: 400;
  }
  li a:hover {
    color: var(--accent);
  }
  time,
  .empty {
    color: var(--muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 30rem) {
    li {
      flex-direction: column;
      gap: 0.1rem;
    }
  }
</style>
